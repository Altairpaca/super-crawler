# Super Crawler 配置
# 复制为 .env 并填入实际值

# Clash代理 (WSL2)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Firecrawl (自部署)
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# GitHub (可选，提高rate limit)
GITHUB_TOKEN=

# SemanticScholar (可选，提高rate limit)
SEMANTIC_SCHOLAR_API_KEY=
